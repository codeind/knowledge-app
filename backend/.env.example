# Copy to .env and fill in. Never commit .env.

# LLM provider API key and model ids (needed for real card generation).
# Without a key the pipeline uses an offline extractive writer, good only for testing.
LLM_API_KEY=
LLM_DRAFT_MODEL=
LLM_VERIFY_MODEL=

# Postgres connection string (e.g. Neon). Leave empty to use the local SQLite file.
DATABASE_URL=

# Optional: free key from https://api.data.gov/signup for US bills (Congress.gov API).
CONGRESS_API_KEY=

# Identify your app to Wikipedia and other APIs (they ask for a contact).
KB_USER_AGENT=knowledge-app/0.1 (your-email@example.com)

# Share of claims that must be supported for a card to be published (0..1).
KB_MIN_QUALITY=0.8

# KB_DB_PATH=data/kb.sqlite3
# KB_FAKE_LLM=1
